{% extends 'skeleton.html.twig' %}

{% block container %}

    <div class="columns is-gapless">
        <div class="column is-12">
            <div class="buttons is-right">
                <a class="button" href="/subscriptions.html">
                    <i class="fa-solid fa-arrow-left"></i>&nbsp;{{ 'subscribe.back'|trans }}
                </a>
            </div>
        </div>
    </div>

    <article class="message is-dark subscription-event">
        <div class="message-header">
            <span>
                {{ 'subscribe.title'|trans({'event': event.name}) }}
                {% if event.secondaryName %}
                    <span class="has-text-weight-normal">&middot; {{ event.secondaryName }}</span>
                {% endif %}
            </span>
        </div>
        <div class="message-body">
            <div class="subscription-facts">
                <div class="subscription-fact">
                    <span class="subscription-fact-label">
                        <i class="fa-regular fa-calendar"></i> {{ 'subscriptions.date'|trans }}
                    </span>
                    <span class="subscription-fact-value">{{ event.startDate|date_range(event.endDate) }}</span>
                </div>
            </div>

            {% if event.form is null %}
                <p>{{ 'subscribe.no_form'|trans }}</p>
            {% else %}
                <p class="has-text-grey">{{ 'subscribe.required_hint'|trans }}</p>
            {% endif %}
        </div>
    </article>

    {% set defaultRole = roles|filter(role => event.isFull(role) == false)|first ?: roles|first %}

    <article class="message is-dark">
        <div class="message-header">
            {{ 'subscribe.role.title'|trans }}
        </div>
        <div class="message-body">
            <div class="subscription-roles">
                {% for role in roles %}
                    {% set cap = event.subscriptionCap(role) %}
                    {% set isFull = event.isFull(role) %}

                    <label class="subscription-role {% if isFull %}is-full{% endif %}">
                        <input type="radio" name="role" value="{{ role.value }}" required
                               {% if role == defaultRole %}checked{% endif %}/>
                        <span class="subscription-role-name">{{ ('subscribe.role.' ~ role.value)|trans }}</span>
                        <span class="subscription-role-places">
                            {% if cap == 0 %}
                                {{ 'subscribe.role.no_cap'|trans }}
                            {% elseif isFull %}
                                <span class="has-text-warning-dark">{{ 'subscribe.role.waiting_list'|trans }}</span>
                            {% else %}
                                {{ 'subscribe.role.places_left'|trans({'left': cap - event.countSubscriptions(role), 'cap': cap}) }}
                            {% endif %}
                        </span>
                    </label>
                {% endfor %}
            </div>
        </div>
    </article>

    {% if event.form is not null %}
        {% for section in event.form.sections %}
            <article class="message is-dark subscription-form-section">
                <div class="message-header">
                    {{ section.title }}
                </div>
                <div class="message-body">
                    {% for fields in section.rows %}
                        <div class="columns">
                            {% for field in fields %}
                                {% set inputName = 'answers[' ~ field.key ~ ']' %}
                                {% set inputId = 'field-' ~ field.key %}

                                <div class="column">
                                    <div class="field">
                                        {% if field.type.value == 'checkbox' %}
                                            <label class="checkbox" for="{{ inputId }}">
                                                <input type="checkbox" id="{{ inputId }}" name="{{ inputName }}" value="1"
                                                       {% if field.required %}required{% endif %}/>
                                                {{ field.label }}
                                                {% if field.required %}<span class="has-text-danger">*</span>{% endif %}
                                            </label>
                                        {% else %}
                                            <label class="label" for="{{ inputId }}">
                                                {{ field.label }}
                                                {% if field.required %}<span class="has-text-danger">*</span>{% endif %}
                                            </label>
                                            <div class="control">
                                                {% if field.type.value == 'textarea' %}
                                                    <textarea class="textarea" id="{{ inputId }}" name="{{ inputName }}" rows="3"
                                                              {% if field.required %}required{% endif %}></textarea>
                                                {% else %}
                                                    <input class="input" id="{{ inputId }}" name="{{ inputName }}"
                                                           type="{{ field.type.value }}"
                                                           {% if field.required %}required{% endif %}/>
                                                {% endif %}
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endfor %}
                </div>
            </article>
        {% endfor %}
    {% endif %}
{% endblock %}
