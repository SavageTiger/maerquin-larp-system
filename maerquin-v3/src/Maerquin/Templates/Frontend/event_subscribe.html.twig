{% extends 'skeleton.html.twig' %}

{% block container %}
    <div class="subscriptions">

        <div class="columns is-gapless">
            <div class="column is-12">
                <div class="buttons is-right">
                    <a class="button" href="/subscriptions.html">
                        <i class="fa-solid fa-arrow-left"></i>&nbsp;{{ 'subscribe.back'|trans }}
                    </a>
                </div>
            </div>
        </div>

        <article class="message is-dark subscription-event">
            <div class="message-header">
                <span>
                    {{ 'subscribe.title'|trans({'event': event.name}) }}
                    {% if event.secondaryName %}
                        <span class="has-text-weight-normal">&middot; {{ event.secondaryName }}</span>
                    {% endif %}
                </span>
            </div>
            <div class="message-body">
                <div class="subscription-facts">
                    <div class="subscription-fact">
                        <span class="subscription-fact-label">
                            <i class="fa-regular fa-calendar"></i> {{ 'subscriptions.date'|trans }}
                        </span>
                        <span class="subscription-fact-value">{{ event.startDate|date_range(event.endDate) }}</span>
                    </div>
                </div>

                <p class="has-text-grey">{{ 'subscribe.required_hint'|trans }}</p>
            </div>
        </article>

        {% set defaultRole = roles|filter(role => not event.occupancy(role).full)|first ?: roles|first %}

        <article class="message is-dark">
            <div class="message-header">
                {{ 'subscribe.role.title'|trans }}
            </div>
            <div class="message-body">
                <div class="subscription-roles">
                    {% for role in roles %}
                        {% set occupancy = event.occupancy(role) %}

                        <label class="subscription-role {% if occupancy.full %}is-full{% endif %}">
                            <input type="radio" name="role" value="{{ role.value }}" required
                                   {% if role == defaultRole %}checked{% endif %}/>
                            <span class="subscription-role-name">{{ ('subscribe.role.' ~ role.value)|trans }}</span>
                            <span class="subscription-role-places">
                                {% if not occupancy.hasCap %}
                                    {{ 'subscribe.role.no_cap'|trans }}
                                {% elseif occupancy.full %}
                                    <span class="has-text-warning-dark">{{ 'subscribe.role.waiting_list'|trans }}</span>
                                {% else %}
                                    {{ 'subscribe.role.places_left'|trans({'left': occupancy.placesLeft, 'cap': occupancy.cap}) }}
                                {% endif %}
                            </span>
                        </label>
                    {% endfor %}
                </div>

                <div class="subscription-character">
                    <span class="subscription-choice-title">{{ 'subscribe.character.choice'|trans }}</span>
                    <div class="subscription-roles">
                        {% for character in characters %}
                            <label class="subscription-role">
                                <input type="radio" name="character" value="{{ character.id }}"
                                       {% if loop.first %}checked{% endif %}/>
                                <span class="subscription-role-name">{{ character.name }}</span>
                                <span class="subscription-role-places">{{ character.race.name }}</span>
                            </label>
                        {% endfor %}
                        <label class="subscription-role">
                            <input type="radio" name="character" value="" {% if characters is empty %}checked{% endif %}/>
                            <span class="subscription-role-name">{{ 'subscribe.character.new_character'|trans }}</span>
                            <span class="subscription-role-places">
                                {{ (characters is empty ? 'subscribe.character.no_characters' : 'subscribe.character.new_hint')|trans }}
                            </span>
                        </label>
                    </div>
                </div>
            </div>
        </article>

        {% for section in event.form.sections|filter(section => section.fields is not empty) %}
            <article class="message is-dark subscription-form-section">
                <div class="message-header">
                    {{ section.title }}
                </div>
                <div class="message-body">
                    {% for fields in section.rows %}
                        <div class="columns">
                            {% for field in fields %}
                                {% set inputName = 'answers[' ~ field.key ~ ']' %}
                                {% set inputId = 'field-' ~ field.key %}

                                <div class="column">
                                    <div class="field">
                                        {% if field.type.value == 'checkbox' %}
                                            <label class="checkbox" for="{{ inputId }}">
                                                <input type="checkbox" id="{{ inputId }}" name="{{ inputName }}" value="1"
                                                       {% if field.required %}required{% endif %}/>
                                                {{ field.label }}
                                                {% if field.required %}<span class="has-text-danger">*</span>{% endif %}
                                            </label>
                                        {% else %}
                                            <label class="label" for="{{ inputId }}">
                                                {{ field.label }}
                                                {% if field.required %}<span class="has-text-danger">*</span>{% endif %}
                                            </label>
                                            <div class="control">
                                                {% if field.type.value == 'textarea' %}
                                                    <textarea class="textarea" id="{{ inputId }}" name="{{ inputName }}" rows="3"
                                                              {% if field.required %}required{% endif %}></textarea>
                                                {% else %}
                                                    <input class="input" id="{{ inputId }}" name="{{ inputName }}"
                                                           type="{{ field.type.value }}"
                                                           {% if field.required %}required{% endif %}/>
                                                {% endif %}
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endfor %}
                </div>
            </article>
        {% endfor %}

        <div class="buttons is-right mb-6">
            <button class="button is-dark is-medium" type="submit" id="subscribeButton">
                <i class="fa-regular fa-paper-plane"></i>&nbsp;{{ 'subscribe.submit'|trans }}
            </button>
        </div>

        <script type="module">
            const form = document.getElementById('containerForm');
            const button = document.getElementById('subscribeButton');

            form.addEventListener('submit', (event) => {
                event.preventDefault();

                if (form.reportValidity() === false) {
                    return;
                }

                const answers = {};

                for (const input of form.querySelectorAll('[name^="answers["]')) {
                    const key = input.name.slice('answers['.length, -1);

                    answers[key] = input.type === 'checkbox' ? (input.checked ? '1' : '') : input.value;
                }

                const role = form.querySelector('[name="role"]:checked')?.value ?? '';

            button.classList.add('is-loading');

                axios
                    .post('/subscriptions/{{ event.id }}.html', {
                        subscription: {
                            role,
                            character: role === 'player' ? (form.querySelector('[name="character"]:checked')?.value ?? '') : '',
                            answers,
                        },
                    })
                    .then(() => {
                        document.location.href = '/subscriptions.html';
                    })
                    .catch((error) => {
                        button.classList.remove('is-loading');
                        alert(error.response?.data?.error?.description ?? error.message);
                    });
            });
        </script>
    </div>
{% endblock %}
