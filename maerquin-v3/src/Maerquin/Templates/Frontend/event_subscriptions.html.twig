{% extends 'skeleton.html.twig' %}

{% macro daysUntil(days) %}
    {%- if days == 0 -%}
        {{ 'subscriptions.today'|trans }}
    {%- elseif days == 1 -%}
        {{ 'subscriptions.tomorrow'|trans }}
    {%- else -%}
        {{ 'subscriptions.days_until'|trans({'days': days}) }}
    {%- endif -%}
{% endmacro %}

{% block container %}
    {% import _self as helpers %}
    {% set upcomingEvents = events|filter(event => event.subscriptionState.value != 'EXPIRED')|reverse %}
    {% set pastEvents = events|filter(event => event.subscriptionState.value == 'EXPIRED') %}

    <div class="spacer is-12"></div>

    {% if upcomingEvents is empty %}
        <article class="message is-dark">
            <div class="message-header">
                {{ 'subscriptions.upcoming'|trans }}
            </div>
            <div class="message-body">
                {{ 'subscriptions.none_planned'|trans }}
            </div>
        </article>
    {% endif %}

    {% for event in upcomingEvents %}
        {% set state = event.subscriptionState.value %}
        {% set daysUntilStart = date(event.startDate).diff(date('today')).days %}
        {% set daysUntilOpening = date(event.subscriptionsOpensAt).diff(date('today')).days %}

        <article class="message is-dark subscription-event">
            <div class="message-header">
                <span>
                    {{ event.name }}
                    {% if event.secondaryName %}
                        <span class="has-text-weight-normal">&middot; {{ event.secondaryName }}</span>
                    {% endif %}
                </span>

                {% if state == 'OPEN' %}
                    <span class="tag is-success">{{ 'subscriptions.state.open'|trans }}</span>
                {% else %}
                    <span class="tag is-warning">{{ 'subscriptions.state.pending'|trans }}</span>
                {% endif %}
            </div>
            <div class="message-body">
                <div class="columns">
                    <div class="column is-5">
                        <dl class="subscription-facts">
                            <dt><i class="fa-regular fa-calendar"></i> {{ 'subscriptions.date'|trans }}</dt>
                            <dd>
                                {% if event.startDate|date('Y-m-d') == event.endDate|date('Y-m-d') %}
                                    {{ event.startDate|date('d-m-Y') }}
                                {% else %}
                                    {{ event.startDate|date('d-m-Y') }} t/m {{ event.endDate|date('d-m-Y') }}
                                {% endif %}
                                <span class="has-text-grey">
                                    ({{ helpers.daysUntil(daysUntilStart) }})
                                </span>
                            </dd>

                            <dt><i class="fa-regular fa-calendar-check"></i> {{ 'subscriptions.registration'|trans }}</dt>
                            <dd>
                                {% if state == 'OPEN' %}
                                    {{ 'subscriptions.registration.open_until'|trans({'date': event.startDate|date('d-m-Y')}) }}
                                {% else %}
                                    {{ 'subscriptions.registration.opens_at'|trans({'date': event.subscriptionsOpensAt|date('d-m-Y')}) }}
                                    <span class="has-text-grey">
                                        ({{ helpers.daysUntil(daysUntilOpening) }})
                                    </span>
                                {% endif %}
                            </dd>

                            {% if event.playerSubscriptionCap > 0 or event.npcSubscriptionCap > 0 %}
                                <dt><i class="fa-solid fa-users"></i> {{ 'subscriptions.places'|trans }}</dt>
                                <dd>
                                    {% if event.playerSubscriptionCap > 0 %}
                                        {{ 'subscriptions.places.players'|trans({'count': event.playerSubscriptionCap}) }}<br/>
                                    {% endif %}
                                    {% if event.npcSubscriptionCap > 0 %}
                                        {{ 'subscriptions.places.npcs'|trans({'count': event.npcSubscriptionCap}) }}
                                    {% endif %}
                                </dd>
                            {% endif %}
                        </dl>

                        <div class="buttons mt-4">
                            {% if player is null %}
                                <a class="button is-dark" href="/login.html?redirect=/subscriptions.html">
                                    <i class="fa-solid fa-right-to-bracket"></i>&nbsp;{{ 'subscriptions.login_to_subscribe'|trans }}
                                </a>
                                <a class="button" href="/register.html">
                                    {{ 'subscriptions.create_account'|trans }}
                                </a>
                            {% elseif event.isSubscribed(player) %}
                                <span class="tag is-success is-medium">
                                    <i class="fa-solid fa-check"></i>&nbsp;{{ 'subscriptions.subscribed'|trans }}
                                </span>
                            {% elseif state == 'OPEN' %}
                                <button class="button is-dark" type="button">
                                    <i class="fa-regular fa-calendar-check"></i>&nbsp;{{ 'subscriptions.subscribe'|trans }}
                                </button>
                            {% endif %}
                        </div>
                    </div>

                    <div class="column is-7">
                        {% if event.description %}
                            <div class="subscription-description content">{{ event.description|markdown_to_html }}</div>
                        {% else %}
                            <p class="has-text-grey">{{ 'subscriptions.no_description'|trans }}</p>
                        {% endif %}
                    </div>
                </div>
            </div>
        </article>
    {% endfor %}

    {% if player is not null and pastEvents is not empty %}
        <article class="message is-dark">
            <div class="message-header">
                {{ 'subscriptions.past'|trans }}
            </div>
            <div class="message-body">
                <div class="table-container">
                    <table class="table is-bordered is-striped is-narrow is-fullwidth">
                        <tr>
                            <th>{{ 'subscriptions.event'|trans }}</th>
                            <th>{{ 'subscriptions.date'|trans }}</th>
                            <th></th>
                        </tr>
                        {% for event in pastEvents %}
                            <tr>
                                <td>{{ event.name }}</td>
                                <td>{{ event.startDate|date('d-m-Y') }}</td>
                                <td>
                                    {% if event.hasParticipated(player) %}
                                        <span class="tag is-info is-light">{{ 'subscriptions.participated'|trans }}</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </table>
                </div>
            </div>
        </article>
    {% endif %}
{% endblock %}
