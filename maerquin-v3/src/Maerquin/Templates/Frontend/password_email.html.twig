{% extends 'Frontend/account_skeleton.html.twig' %}

{% block account_content %}
    {% if sent %}
        <article class="message is-success">
            <div class="message-header"><p>E-mail verstuurd</p></div>
            <div class="message-body">
                Als dit e-mailadres bij ons bekend is, ontvang je binnen enkele minuten een e-mail
                met een link om je wachtwoord in te stellen.
            </div>
        </article>
    {% else %}
        <form method="POST" class="box">
            <h4 class="title is-4">Wachtwoord instellen</h4>
            <p>Vul je e-mailadres in. Je ontvangt een link waarmee je een (nieuw) wachtwoord instelt.</p>

            <div class="field">
                <label class="label" for="email">E-mailadres</label>
                <div class="control has-icons-left">
                    <input id="email" type="email" name="passwordEmail[email]" class="input" required
                           value="{{ form.getValue('email', 'passwordEmail', '') }}" placeholder="john@example.com">
                    <span class="icon is-small is-left"><i class="fa fa-envelope"></i></span>
                </div>
            </div>

            <div class="field">
                <button type="submit" class="button is-success">Verstuur e-mail</button>
            </div>

            <p><a href="/login.html">Terug naar inloggen</a></p>
        </form>
    {% endif %}
{% endblock %}
