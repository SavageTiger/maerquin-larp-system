{% extends 'skeleton.html.twig' %}

{% block container %}
    <div class="columns is-gapless">
        <div class="column is-12 is-gapless">
            <a class="button is-pulled-right" href="/admin/form/create.html">
                <i class="fa-solid fa-circle-plus"></i>&nbsp;{{ 'forms.create'|trans }}
            </a>
        </div>
    </div>

    <div class="columns is-gapless">
        <div class="column is-12">
            <table class="table is-bordered is-striped is-narrow is-hoverable is-overview-table">
                <tr>
                    <th>{{ 'forms.name'|trans }}</th>
                    <th>{{ 'forms.section_count'|trans }}</th>
                    <th>{{ 'forms.field_count'|trans }}</th>
                </tr>
                {% for form in forms %}
                    <tr>
                        <td><a href="/admin/forms/{{ form.id }}.html">{{ form.name }}</a></td>
                        <td>{{ form.sections|length }}</td>
                        <td>{{ form.sections|reduce((count, section) => count + section.fields|length, 0) }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3">{{ 'forms.empty'|trans }}</td>
                    </tr>
                {% endfor %}
            </table>
        </div>
    </div>
{% endblock %}
