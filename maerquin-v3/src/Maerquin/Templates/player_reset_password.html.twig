{% extends 'Frontend/account_skeleton.html.twig' %}

{% block account_content %}
    {% if persisted %}
        <article class="message is-success">
            <div class="message-header"><p>Wachtwoord ingesteld</p></div>
            <div class="message-body">
                <p>Je nieuwe wachtwoord is opgeslagen. Je kunt nu inloggen.</p>
                <br>
                <a href="/login.html" class="button is-success">
                    <i class="fa-solid fa-right-to-bracket"></i>&nbsp;Inloggen
                </a>
            </div>
        </article>

    {% elseif token is null %}
        <article class="message is-danger">
            <div class="message-header"><p>Link ongeldig</p></div>
            <div class="message-body">
                <p>Deze link is ongeldig of verlopen.</p>
                <br>
                <a href="/password-email.html" class="button is-danger">
                    <i class="fa-solid fa-envelope"></i>&nbsp;Vraag een nieuwe link aan
                </a>
            </div>
        </article>
        <p><a href="/login.html">Terug naar inloggen</a></p>

    {% else %}
        <article id="resetPasswordError" class="message is-danger is-hidden">
            <div class="message-header"><p>Opslaan mislukt</p></div>
            <div class="message-body"></div>
        </article>

        <form id="containerForm" class="box">
            <h4 class="title is-4">Wachtwoord instellen</h4>

            <div class="field">
                <label class="label" for="username">Gebruikersnaam</label>
                <div class="control has-icons-left">
                    <input id="username" type="text" class="input" disabled value="{{ token.user.name }}">
                    <span class="icon is-small is-left"><i class="fa fa-user"></i></span>
                </div>
            </div>

            <div class="field">
                <label class="label" for="password">Nieuw wachtwoord</label>
                <div class="control has-icons-left">
                    <input id="password" type="password" name="password" class="input" required
                           minlength="8" autocomplete="new-password" placeholder="*******" autofocus>
                    <span class="icon is-small is-left"><i class="fa fa-lock"></i></span>
                </div>
                <p class="help">Minimaal 8 tekens.</p>
            </div>

            <div class="field">
                <label class="label" for="passwordRepeat">Herhaal wachtwoord</label>
                <div class="control has-icons-left">
                    <input id="passwordRepeat" type="password" name="passwordRepeat" class="input" required
                           minlength="8" autocomplete="new-password" placeholder="*******">
                    <span class="icon is-small is-left"><i class="fa fa-lock"></i></span>
                </div>
            </div>

            <div class="field">
                <button id="resetPasswordSubmit" type="submit" class="button is-success">
                    <i class="fa-solid fa-save"></i>&nbsp;Opslaan
                </button>
            </div>

            <p><a href="/login.html">Terug naar inloggen</a></p>
        </form>

        <script>
            document.getElementById('containerForm').addEventListener('submit', (event) => {
                event.preventDefault();

                const errorBox = document.getElementById('resetPasswordError');
                const submitButton = document.getElementById('resetPasswordSubmit');

                errorBox.classList.add('is-hidden');
                submitButton.classList.add('is-loading');

                axios
                    .post(`/reset-password/{{ token.value }}.html`, { password: serializeForm('containerForm') })
                    .then(() => {
                        document.location.href = `/reset-password/persisted/{{ token.value }}.html`;
                    })
                    .catch((error) => {
                        errorBox.querySelector('.message-body').textContent =
                            error.response?.data?.error?.description || 'Er ging iets mis, probeer het opnieuw.';
                        errorBox.classList.remove('is-hidden');
                        submitButton.classList.remove('is-loading');
                    });
            });
        </script>
    {% endif %}
{% endblock %}
