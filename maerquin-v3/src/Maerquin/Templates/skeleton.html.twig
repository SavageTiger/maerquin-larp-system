{% extends 'base.html.twig' %}

{% block main %}
    <nav class="navbar is-fixed-top has-background-primary-25" role="navigation" aria-label="main navigation">
        <div class="navbar-brand">
            <div class="logo">
                <i class="fa-solid fa-book-skull"></i>&nbsp;Maerquin Character Database
            </div>
        </div>

        <div class="navbar-menu">
            <div class="navbar-start">
                {% if getUser().isAdmin %}
                    <a href="/admin/players.html"
                       class="navbar-item {% if 'player' in current_url() %}is-active{% endif %}">
                        <i class="fa-solid fa-user-group"></i> Spelers
                    </a>

                    <a href="/admin/subscriptions.html"
                       class="navbar-item {% if 'subscriptions' in current_url() %}is-active{% endif %}">
                        <i class="fa-solid fa-people-roof"></i> Inschrijvingen
                    </a>

                    <a href="/admin/characters.html"
                       class="navbar-item {% if 'character' in current_url() %}is-active{% endif %}">
                        <i class="fa-solid fa-hat-wizard"></i> Personages
                    </a>

                    <a href="/admin/events.html"
                       class="navbar-item {% if 'event' in current_url() %}is-active{% endif %}">
                        <i class="fa-regular fa-calendar-days"></i> Evenementen
                    </a>

                    <a href="/admin/skills.html"
                       class="navbar-item {% if 'skills' in current_url() %}is-active{% endif %}">
                        <i class="fa-solid fa-scroll"></i> Skills
                    </a>

                    <a href="/admin/races.html"
                       class="navbar-item {% if 'races' in current_url() %}is-active{% endif %}">
                        <i class="fa-solid fa-hand-spock"></i> Rassen
                    </a>
                {% endif %}
            </div>

            <div class="navbar-end">
                {% if getUser().isAdmin %}
                    <div class="navbar-item has-dropdown is-hoverable">
                        <a class="navbar-link {% if 'status' in current_url() or 'forms' in current_url() %}is-active{% endif %}">
                            <i class="fa-solid fa-gear"></i>&nbsp;{{ 'menu.settings'|trans }}
                        </a>

                        <div class="navbar-dropdown is-right">
                            <a href="/admin/status.html"
                               class="navbar-item {% if 'status' in current_url() %}is-active{% endif %}">
                                <i class="fa-solid fa-signal"></i>&nbsp;{{ 'menu.settings.status'|trans }}
                            </a>
                            <a href="/admin/forms.html"
                               class="navbar-item {% if 'forms' in current_url() %}is-active{% endif %}">
                                <i class="fa-solid fa-list-check"></i>&nbsp;{{ 'menu.settings.forms'|trans }}
                            </a>
                        </div>
                    </div>
                {% endif %}

                {% if getUser().username %}
                    <a href="/logout.html" class="navbar-item">
                        <i class="fa-solid fa-door-open"></i> Uitloggen ({{ getUser().username|capitalize }})
                    </a>
                {% endif %}
            </div>
        </div>
    </nav>

    <div class="container">
        <form id="containerForm">
            {% block container %}
            {% endblock %}
        </form>
    </div>
{% endblock %}
