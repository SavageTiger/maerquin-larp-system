{% extends 'skeleton.html.twig' %}

{% block container %}
    <div class="spacer is-12"></div>

    <article class="message is-dark">
        <div class="message-header">
            {{ 'admin.subscriptions.latest'|trans }}
        </div>
        <div class="message-body">
            <div class="table-container">
                <table class="table is-bordered is-striped is-narrow is-hoverable is-fullwidth">
                    <tr>
                        <th>{{ 'subscriptions.event'|trans }}</th>
                        <th>{{ 'subscriptions.date'|trans }}</th>
                        <th>{{ 'subscriptions.registration'|trans }}</th>
                        {% for role in roles %}
                            <th>{{ ('admin.subscriptions.role.' ~ role.value)|trans }}</th>
                        {% endfor %}
                    </tr>
                    {% for event in events %}
                        {% set state = event.subscriptionState.value %}
                        <tr>
                            <td><a href="/admin/subscriptions/{{ event.id }}.html">{{ event.name }}</a></td>
                            <td>{{ event.startDate|date_range(event.endDate) }}</td>
                            <td>
                                {% if state == 'OPEN' %}
                                    <span class="tag is-success is-light">{{ 'subscriptions.state.open'|trans }}</span>
                                {% elseif state == 'PENDING' %}
                                    <span class="tag is-warning is-light">{{ 'subscriptions.state.pending'|trans }}</span>
                                {% else %}
                                    <span class="tag is-light">{{ 'admin.subscriptions.state.closed'|trans }}</span>
                                {% endif %}
                            </td>
                            {% for role in roles %}
                                {% set occupancy = event.occupancy(role) %}
                                <td>
                                    {{ occupancy.confirmed }}{% if occupancy.hasCap %} / {{ occupancy.cap }}{% endif %}
                                    {{ 'admin.subscriptions.count.confirmed'|trans }}
                                    <br>
                                    <span class="has-text-grey is-size-7">
                                        {{ 'admin.subscriptions.count.registered'|trans({'count': occupancy.registered}) }}
                                    </span>
                                </td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                </table>
            </div>
        </div>
    </article>
{% endblock %}
