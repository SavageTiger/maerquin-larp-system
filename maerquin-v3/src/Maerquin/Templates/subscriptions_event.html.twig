{% extends 'skeleton.html.twig' %}

{% block container %}
    <div class="subscriptions">
        <div class="columns is-gapless">
            <div class="column is-12">
                <div class="buttons is-right">
                    <a class="button" href="/admin/subscriptions.html">
                        <i class="fa-solid fa-arrow-left"></i>&nbsp;{{ 'admin.subscriptions.back'|trans }}
                    </a>
                </div>
            </div>
        </div>

        <article class="message is-dark subscription-event">
            <div class="message-header">
                <span>
                    {{ event.name }}
                    {% if event.secondaryName %}
                        <span class="has-text-weight-normal">&middot; {{ event.secondaryName }}</span>
                    {% endif %}
                </span>
            </div>
            <div class="message-body">
                <div class="subscription-facts">
                    <div class="subscription-fact">
                        <span class="subscription-fact-label">
                            <i class="fa-regular fa-calendar"></i> {{ 'subscriptions.date'|trans }}
                        </span>
                        <span class="subscription-fact-value">{{ event.startDate|date_range(event.endDate) }}</span>
                        <span class="subscription-fact-detail">{{ event.startDate|days_until }}</span>
                    </div>

                    {% for role in roles %}
                        {% set occupancy = event.occupancy(role) %}
                        <div class="subscription-fact">
                            <span class="subscription-fact-label">
                                <i class="fa-solid fa-users"></i> {{ ('admin.subscriptions.role.' ~ role.value)|trans }}
                            </span>
                            <span class="subscription-fact-value">
                                {{ occupancy.confirmed }}{% if occupancy.hasCap %} / {{ occupancy.cap }}{% endif %}
                                <span class="subscription-fact-unit">{{ 'admin.subscriptions.count.confirmed'|trans }}</span>
                            </span>
                            {% if occupancy.hasCap %}
                                <progress class="progress is-small {{ occupancy.overbooked ? 'is-danger' : 'is-success' }}"
                                          value="{{ occupancy.confirmed }}" max="{{ occupancy.cap }}"></progress>
                            {% endif %}
                            <span class="subscription-fact-detail">
                                {{ 'admin.subscriptions.count.registered'|trans({'count': occupancy.registered}) }}
                                {%- if occupancy.waitingList %} &middot; {{ 'admin.subscriptions.count.waiting_list'|trans({'count': occupancy.waitingList}) }}{% endif %}
                                {%- if not occupancy.hasCap %} &middot; {{ 'subscribe.role.no_cap'|trans|lower }}{% endif %}
                            </span>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </article>

        {% set status_toggles = {
            'confirmed': {class: 'is-success', icon: 'fa-check', action: 'confirm'},
            'waiting_list': {class: 'is-warning', icon: 'fa-hourglass-half', action: 'place_on_waiting_list'}
        } %}

        {% for role in roles %}
            {% set subscriptions = event.subscriptions(role) %}

            <article class="message is-dark">
                <div class="message-header">
                    {{ ('admin.subscriptions.role.' ~ role.value)|trans }}
                </div>
                <div class="message-body">
                    {% if subscriptions is empty %}
                        <p class="has-text-grey">{{ 'admin.subscriptions.none'|trans }}</p>
                    {% endif %}

                    {% for subscription in subscriptions %}
                        {% set submission = subscription.formSubmission %}

                        <details class="admin-subscription">
                            <summary>
                                <span class="admin-subscription-number">{{ loop.index }}</span>
                                <span class="admin-subscription-main">
                                    <span class="admin-subscription-name">{{ subscription.player.name }}</span>
                                    {% if role.value == 'player' %}
                                        {% if subscription.character is null %}
                                            <span class="tag is-light mb-0">{{ 'admin.subscriptions.new_character'|trans }}</span>
                                        {% else %}
                                            <span class="has-text-grey">
                                                <i class="fa-solid fa-hat-wizard"></i> {{ subscription.character.name }}
                                            </span>
                                        {% endif %}
                                    {% endif %}
                                </span>
                                <span class="admin-subscription-date">{{ subscription.subscribedAt|date('d-m-Y H:i') }}</span>
                                <span class="admin-subscription-actions" data-url="/admin/subscriptions/{{ event.id }}/{{ subscription.id }}">
                                    {% if subscription.paid %}
                                        <button class="button is-small is-success" type="button" aria-pressed="true"
                                                title="{{ 'admin.subscriptions.mark_unpaid'|trans }}"
                                                data-action="mark_as_unpaid"
                                                data-confirm="{{ 'admin.subscriptions.mark_unpaid.confirm'|trans }}">
                                            <span class="icon"><i class="fa-solid fa-euro-sign"></i></span>
                                            <span>{{ 'subscriptions.payment.paid'|trans }}</span>
                                        </button>
                                    {% else %}
                                        <button class="button is-small" type="button" aria-pressed="false"
                                                title="{{ 'admin.subscriptions.mark_paid'|trans }}"
                                                aria-label="{{ 'admin.subscriptions.mark_paid'|trans }}"
                                                data-action="mark_as_paid">
                                            <span class="icon"><i class="fa-solid fa-euro-sign"></i></span>
                                        </button>
                                    {% endif %}

                                    {% for status, style in status_toggles %}
                                        {% if subscription.status.value == status %}
                                            <button class="button is-small {{ style.class }}" type="button" aria-pressed="true"
                                                    title="{{ 'admin.subscriptions.status.reset'|trans }}"
                                                    data-action="reset_status">
                                                <span class="icon"><i class="fa-solid {{ style.icon }}"></i></span>
                                                <span>{{ ('admin.subscriptions.status.' ~ status)|trans }}</span>
                                            </button>
                                        {% else %}
                                            <button class="button is-small" type="button" aria-pressed="false"
                                                    title="{{ ('admin.subscriptions.status.' ~ status ~ '.mark')|trans }}"
                                                    aria-label="{{ ('admin.subscriptions.status.' ~ status ~ '.mark')|trans }}"
                                                    data-action="{{ style.action }}">
                                                <span class="icon"><i class="fa-solid {{ style.icon }}"></i></span>
                                            </button>
                                        {% endif %}
                                    {% endfor %}
                                </span>
                            </summary>

                            <div class="admin-subscription-answers">
                                {% for section in submission.form.sections %}
                                    <table class="table is-narrow is-striped is-fullwidth admin-subscription-section">
                                        <thead>
                                            <tr><th colspan="2">{{ section.title }}</th></tr>
                                        </thead>
                                        <tbody>
                                            {% for field in section.fields %}
                                                {% set answer = submission.answer(field.key) %}
                                                <tr>
                                                    <td class="admin-subscription-label">{{ field.label }}</td>
                                                    <td class="admin-subscription-value">
                                                        {%- if answer is null or answer == '' -%}
                                                            <span class="has-text-grey-light">&mdash;</span>
                                                        {%- elseif field.type.value == 'checkbox' -%}
                                                            {{ 'admin.subscriptions.yes'|trans }}
                                                        {%- elseif field.type.value == 'date' -%}
                                                            {{ date(answer)|long_date }}
                                                        {%- else -%}
                                                            {{ answer|nl2br }}
                                                        {%- endif -%}
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                {% endfor %}
                            </div>
                        </details>
                    {% endfor %}
                </div>
            </article>
        {% endfor %}

        <script>
            document.querySelectorAll('.admin-subscription-actions').forEach((actions) => {
                actions.addEventListener('click', (event) => {
                    // Buttons live inside <summary>: never let a click toggle the details.
                    event.preventDefault();

                    const button = event.target.closest('button[data-action]');

                    if (button === null || (button.dataset.confirm && confirm(button.dataset.confirm) === false)) {
                        return;
                    }

                    button.classList.add('is-loading');

                    axios
                        .post(actions.dataset.url, {subscription: {action: button.dataset.action}})
                        .then(() => document.location.reload())
                        .catch((error) => {
                            button.classList.remove('is-loading');
                            alert(error.response?.data?.error?.description ?? error.message);
                        });
                });
            });
        </script>
    </div>
{% endblock %}
